# Premier League Valuation Intelligence - Backend Environment Configuration

PROJECT_NAME="Premier League Valuation Intelligence API"
VERSION="1.0.0"
API_PREFIX="/api"

# Database Configuration (PostgreSQL supported, default SQLite for local development)
DATABASE_URL="sqlite:///./data/pl_valuation.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pl_valuation"

# Model Configuration
MODEL_PATH="./data/processed/ml/best_model.joblib"
MODEL_VERSION="xgboost-v1"

# Server Settings
API_HOST="127.0.0.1"
API_PORT=8000
