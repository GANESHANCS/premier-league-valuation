# Premier League Valuation Intelligence (PL ValuEdge)
# Environment Configuration Template

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Backend Configuration
DATABASE_URL=sqlite:///data/pl_valuation.db
MODEL_PATH=data/processed/ml/best_model.joblib

# Security & CORS
# Comma-separated allowed origins (e.g. http://localhost:5173,http://localhost:3000,https://pl-valuedge.example.com)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
